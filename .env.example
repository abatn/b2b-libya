# Libya B2B Platform - Umgebungsvariablen
# Kopiere diese Datei zu .env und passe die Werte an

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=sqlite:///./libya_b2b.db

# ============================================================
# API SETTINGS
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================
# APP SETTINGS
# ============================================================
APP_NAME=Libya B2B Platform
APP_VERSION=1.5.0
DEBUG=true

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ============================================================
# OFFLINE SETTINGS
# ============================================================
OFFLINE_MODE=true
SYNC_INTERVAL=300

# ============================================================
# EMAIL / SMTP (Verification Codes, Password Resets)
# ============================================================
# Leave SMTP_HOST empty to use console fallback (dev mode)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# For Mailgun: SMTP_HOST=smtp.mailgun.org, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ============================================================
# PUSH NOTIFICATIONS (VAPID)
# ============================================================
# Generate with: py_vapid --generate (see vapid_keys/ directory)
# VAPID_PRIVATE_KEY is the PEM private key (multiline, wrap in quotes)
# VAPID_PUBLIC_KEY is the URL-safe base64 public key
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# ============================================================
# DOCKER (nur fuer Docker-Setup)
# ============================================================
POSTGRES_DB=libya_b2b
POSTGRES_USER=libya
POSTGRES_PASSWORD=change_me_in_production
REDIS_URL=redis://redis:6379
